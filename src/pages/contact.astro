---
import Layout from '../layouts/Layout.astro';
import { breadcrumbSchema, faqSchema, SITE_URL } from '../utils/schema';

const contactFaqs = [
  { question: 'How soon can we start?', answer: 'Depends on availability. The sprint can often start quickly; retainer engagements may have a short waitlist.' },
  { question: 'Do you sign NDAs?', answer: 'Yes, if needed. Happy to sign before we discuss details.' },
  { question: 'Do you work async?', answer: "Yes\u2014I'm async-friendly with a weekly touchpoint to stay aligned. Works well for distributed teams." },
];

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: SITE_URL },
    { name: 'Contact', url: `${SITE_URL}/contact` },
  ]),
  faqSchema(contactFaqs),
];

const greatFit = [
  'Service/logistics businesses with remote or distributed ops',
  'Recurring admin load, scheduling complexity, or handoff issues',
  'Willingness to standardize and document processes',
  'Ready to invest in systems that scale',
];

const notAFit = [
  'Ecommerce or manufacturing operations',
  'Onsite-heavy operations where bottlenecks are physical',
  'Looking for a one-hour "Zapier trick" with no process ownership',
  'Not ready to make changes to how things work',
];
---

<Layout
  title="Work With Me | Free Systems Audit Call | Build with Jeremy"
  description="Book a free Systems Audit Call. I'll map the bottleneck and outline the fastest path to remove it."
  jsonLd={jsonLd}
>
  <!-- Calendly CSS -->
  <link slot="head" href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />

  <!-- Header Section -->
  <section class="theme-bg-primary py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-brand font-semibold mb-3">Work With Me</p>
      <h1 class="text-4xl md:text-5xl font-bold theme-text-primary">
        Let's fix the bottleneck.
      </h1>
      <p class="mt-4 text-xl theme-text-secondary max-w-2xl mx-auto">
        Start with a free Systems Audit Call. I'll map what's breaking and recommend the fastest path to remove it—no pressure, no pitch.
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="theme-bg-secondary py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

        <!-- Left Column: Fit Check -->
        <div class="lg:col-span-1 space-y-8">
          <!-- What happens on the call -->
          <div class="theme-bg-primary rounded-xl p-6 border transition-colors" style="border-color: var(--border-color);">
            <h2 class="text-lg font-bold theme-text-primary mb-4">What happens on the call</h2>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-sm theme-text-secondary">
                <span class="flex-shrink-0 h-6 w-6 bg-brand/10 rounded-full flex items-center justify-center text-brand font-bold text-xs">1</span>
                <span>Quick walkthrough of your current workflow + tools</span>
              </li>
              <li class="flex items-start gap-3 text-sm theme-text-secondary">
                <span class="flex-shrink-0 h-6 w-6 bg-brand/10 rounded-full flex items-center justify-center text-brand font-bold text-xs">2</span>
                <span>Identify the bottleneck + quick wins</span>
              </li>
              <li class="flex items-start gap-3 text-sm theme-text-secondary">
                <span class="flex-shrink-0 h-6 w-6 bg-brand/10 rounded-full flex items-center justify-center text-brand font-bold text-xs">3</span>
                <span>Recommend a path (retainer, sprint, or AI audit)</span>
              </li>
            </ul>
          </div>

          <!-- Great fit -->
          <div class="theme-bg-primary rounded-xl p-6 border transition-colors" style="border-color: var(--border-color);">
            <h2 class="text-lg font-bold theme-text-primary mb-4 flex items-center gap-2">
              <svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Great fit
            </h2>
            <ul class="space-y-2">
              {greatFit.map((item) => (
                <li class="flex items-start gap-2 text-sm theme-text-secondary">
                  <svg class="h-4 w-4 text-accent flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Not a fit -->
          <div class="theme-bg-primary rounded-xl p-6 border transition-colors" style="border-color: var(--border-color);">
            <h2 class="text-lg font-bold theme-text-primary mb-4 flex items-center gap-2">
              <svg class="h-5 w-5 theme-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              Not a fit
            </h2>
            <ul class="space-y-2">
              {notAFit.map((item) => (
                <li class="flex items-start gap-2 text-sm theme-text-muted">
                  <svg class="h-4 w-4 theme-text-muted flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Right Column: Qualified Booking (2 steps) -->
        <div class="lg:col-span-2">
          <div class="theme-bg-primary rounded-2xl shadow-lg p-6 md:p-8 border transition-colors" style="border-color: var(--border-color);">

            <!-- Step 1: Quick fit check -->
            <div id="qualify-step">
              <h2 class="text-2xl font-bold theme-text-primary mb-2 text-center">
                Book a Free Systems Audit Call
              </h2>
              <p class="theme-text-secondary text-center mb-6">
                Two quick steps: tell me what's breaking, then pick a time.
              </p>

              <form id="qualify-form" class="space-y-5">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label for="q-name" class="block text-sm font-medium theme-text-primary mb-1.5">Name <span class="text-brand">*</span></label>
                    <input
                      id="q-name"
                      name="name"
                      type="text"
                      required
                      autocomplete="name"
                      class="w-full px-4 py-3 rounded-lg border focus:ring-2 focus:ring-brand focus:border-transparent outline-none theme-bg-secondary theme-text-primary transition-colors"
                      style="border-color: var(--border-color);"
                    />
                  </div>
                  <div>
                    <label for="q-email" class="block text-sm font-medium theme-text-primary mb-1.5">Email <span class="text-brand">*</span></label>
                    <input
                      id="q-email"
                      name="email"
                      type="email"
                      required
                      autocomplete="email"
                      class="w-full px-4 py-3 rounded-lg border focus:ring-2 focus:ring-brand focus:border-transparent outline-none theme-bg-secondary theme-text-primary transition-colors"
                      style="border-color: var(--border-color);"
                    />
                  </div>
                  <div>
                    <label for="q-company" class="block text-sm font-medium theme-text-primary mb-1.5">Company</label>
                    <input
                      id="q-company"
                      name="company"
                      type="text"
                      autocomplete="organization"
                      class="w-full px-4 py-3 rounded-lg border focus:ring-2 focus:ring-brand focus:border-transparent outline-none theme-bg-secondary theme-text-primary transition-colors"
                      style="border-color: var(--border-color);"
                    />
                  </div>
                  <div>
                    <label for="q-role" class="block text-sm font-medium theme-text-primary mb-1.5">Which best describes you? <span class="text-brand">*</span></label>
                    <select
                      id="q-role"
                      name="role"
                      required
                      class="w-full px-4 py-3 rounded-lg border focus:ring-2 focus:ring-brand focus:border-transparent outline-none theme-bg-secondary theme-text-primary transition-colors"
                      style="border-color: var(--border-color);"
                    >
                      <option value="" disabled selected>Select one…</option>
                      <option value="service business owner">Service business owner</option>
                      <option value="agency">Agency</option>
                      <option value="startup">Startup</option>
                      <option value="other">Other</option>
                    </select>
                  </div>
                  <div>
                    <label for="q-revenue" class="block text-sm font-medium theme-text-primary mb-1.5">Monthly revenue <span class="text-brand">*</span></label>
                    <select
                      id="q-revenue"
                      name="revenue_band"
                      required
                      class="w-full px-4 py-3 rounded-lg border focus:ring-2 focus:ring-brand focus:border-transparent outline-none theme-bg-secondary theme-text-primary transition-colors"
                      style="border-color: var(--border-color);"
                    >
                      <option value="" disabled selected>Select one…</option>
                      <option value="<$20k/mo">Under $20k/mo</option>
                      <option value="$20-80k/mo">$20–80k/mo</option>
                      <option value="$80k+/mo">$80k+/mo</option>
                      <option value="prefer not to say">Prefer not to say</option>
                    </select>
                  </div>
                  <div>
                    <label for="q-timeline" class="block text-sm font-medium theme-text-primary mb-1.5">Timeline <span class="text-brand">*</span></label>
                    <select
                      id="q-timeline"
                      name="timeline"
                      required
                      class="w-full px-4 py-3 rounded-lg border focus:ring-2 focus:ring-brand focus:border-transparent outline-none theme-bg-secondary theme-text-primary transition-colors"
                      style="border-color: var(--border-color);"
                    >
                      <option value="" disabled selected>Select one…</option>
                      <option value="ASAP">ASAP</option>
                      <option value="this quarter">This quarter</option>
                      <option value="exploring">Just exploring</option>
                    </select>
                  </div>
                </div>
                <div>
                  <label for="q-broken" class="block text-sm font-medium theme-text-primary mb-1.5">What's broken?</label>
                  <textarea
                    id="q-broken"
                    name="whats_broken"
                    rows="4"
                    placeholder="The workflow, handoff, or admin mess that made you look for help…"
                    class="w-full px-4 py-3 rounded-lg border focus:ring-2 focus:ring-brand focus:border-transparent outline-none theme-bg-secondary theme-text-primary transition-colors resize-y"
                    style="border-color: var(--border-color);"
                  ></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-full text-lg py-4">
                  Continue to pick a time →
                </button>
                <p class="text-xs theme-text-muted text-center">
                  No pressure, no pitch. Your answers just make the call more useful.
                </p>
              </form>

              <!-- Low-intent path -->
              <div class="mt-8 pt-6 border-t text-center transition-colors" style="border-color: var(--border-color);">
                <p class="text-sm theme-text-secondary">
                  Not ready for a call?
                  <a href="/resources#newsletter" class="text-brand font-semibold hover:underline">Grab the newsletter instead</a>.
                </p>
              </div>
            </div>

            <!-- Step 2: Calendly -->
            <div id="booking-step" class="hidden">
              <h2 class="text-2xl font-bold theme-text-primary mb-2 text-center">
                Pick a time
              </h2>
              <p class="text-sm theme-text-secondary text-center mb-4">
                Booking as <span id="booking-identity" class="font-semibold theme-text-primary"></span>
                <button type="button" id="booking-back" class="ml-2 text-brand font-semibold hover:underline">Edit answers</button>
              </p>
              <div id="calendly-container" style="min-width:320px;height:750px;overflow:visible;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternative Contact -->
  <section class="theme-bg-primary py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl font-bold theme-text-primary">Prefer another way?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="theme-bg-secondary rounded-xl p-8 text-center border transition-colors" style="border-color: var(--border-color);">
          <div class="h-12 w-12 bg-brand/10 rounded-full flex items-center justify-center mx-auto">
            <svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-bold theme-text-primary">Email Me</h3>
          <p class="mt-2 theme-text-secondary text-sm">
            Send me a message and I'll get back to you within 1–2 business days.
          </p>
          <a href="mailto:hello@buildwithjeremy.com" class="mt-4 text-brand font-semibold hover:underline inline-block">
            hello@buildwithjeremy.com
          </a>
        </div>

        <div class="theme-bg-secondary rounded-xl p-8 text-center border transition-colors" style="border-color: var(--border-color);">
          <div class="h-12 w-12 bg-brand/10 rounded-full flex items-center justify-center mx-auto">
            <svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-bold theme-text-primary">Connect on LinkedIn</h3>
          <p class="mt-2 theme-text-secondary text-sm">
            Let's connect! I share tips on ops and automation.
          </p>
          <a href="https://www.linkedin.com/in/jeremy-pittman-49720428" target="_blank" rel="noopener noreferrer" class="mt-4 text-brand font-semibold hover:underline inline-block">
            Follow on LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="theme-bg-secondary py-16 lg:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl font-bold theme-text-primary">Quick questions</h2>
      </div>
      <div class="space-y-4">
        {contactFaqs.map((faq) => (
          <details class="group theme-bg-primary rounded-xl border transition-colors" style="border-color: var(--border-color);">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold theme-text-primary">
              {faq.question}
              <svg class="h-5 w-5 theme-text-muted group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 theme-text-secondary">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Calendly Script -->
  <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>

  <!-- Qualified booking flow -->
  <script>
    const form = document.getElementById('qualify-form') as HTMLFormElement | null;
    const qualifyStep = document.getElementById('qualify-step');
    const bookingStep = document.getElementById('booking-step');
    const identityEl = document.getElementById('booking-identity');
    const backBtn = document.getElementById('booking-back');
    const container = document.getElementById('calendly-container');

    const CALENDLY_BASE = 'https://calendly.com/buildwithjeremy/free-consultation';

    function initCalendly(url: string) {
      if (!container) return;
      container.innerHTML = '';
      const calendly = (window as any).Calendly;
      if (calendly?.initInlineWidget) {
        calendly.initInlineWidget({ url, parentElement: container });
      } else {
        // widget.js loads async — fall back to a plain iframe embed
        const iframe = document.createElement('iframe');
        iframe.src = `${url}&embed_domain=${encodeURIComponent(window.location.host)}&embed_type=Inline`;
        iframe.width = '100%';
        iframe.height = '100%';
        iframe.frameBorder = '0';
        iframe.title = 'Select a time to meet';
        container.appendChild(iframe);
      }
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form) return;

      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const company = String(data.get('company') || '').trim();
      const role = String(data.get('role') || '');
      const revenueBand = String(data.get('revenue_band') || '');
      const timeline = String(data.get('timeline') || '');
      const whatsBroken = String(data.get('whats_broken') || '').trim();

      // GA4 — same gtag pattern as GoogleAnalytics.astro (only defined in prod)
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'qualified_booking_start', {
          event_category: 'booking',
          role,
          revenue_band: revenueBand,
          timeline,
        });
      }

      // Capture the lead even if the booking never completes (fire-and-forget)
      fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          name,
          source: 'contact-qualified',
          fields: {
            company,
            role,
            revenue_band: revenueBand,
            timeline,
            whats_broken: whatsBroken,
          },
        }),
      }).catch(() => {});

      // Compact summary → Calendly custom-answer prefill (a1)
      const summary = [role, revenueBand, timeline, company, whatsBroken]
        .filter(Boolean)
        .join(' | ')
        .slice(0, 250);
      const params = new URLSearchParams({
        hide_gdpr_banner: '1',
        name,
        email,
        a1: summary,
      });

      if (identityEl) identityEl.textContent = `${name} (${email})`;
      qualifyStep?.classList.add('hidden');
      bookingStep?.classList.remove('hidden');
      initCalendly(`${CALENDLY_BASE}?${params.toString()}`);
      bookingStep?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    backBtn?.addEventListener('click', () => {
      bookingStep?.classList.add('hidden');
      qualifyStep?.classList.remove('hidden');
      qualifyStep?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>
</Layout>
