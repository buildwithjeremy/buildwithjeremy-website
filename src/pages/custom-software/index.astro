---
// Public custom software page. The BWJ side of the cross-brand pair: Build with
// Jeremy answers "who do I hire", Build My System answers "what do we build".
// Mirror of buildmysystem.co/consulting, which points the other way.
// Cross-site links carry no utm parameters (see BrandHandoff.astro for why).
// The client-only plan builder that used to live here is /your-plan/.
import Layout from '../../layouts/Layout.astro';
import { breadcrumbSchema, faqSchema, serviceSchema, SITE_URL } from '../../utils/schema';

const url = `${SITE_URL}/custom-software`;

const faqs = [
  {
    question: 'Do you build custom software?',
    answer:
      'Yes. Custom software is built under Build My System, my software company for service businesses. Same team, same standards, with its own site, a quote builder, and published pricing. Build with Jeremy is the consulting side.',
  },
  {
    question: 'What is the difference between Build with Jeremy and Build My System?',
    answer:
      'Build with Jeremy is operations consulting: finding the constraint, fixing the process, and training the team. Build My System designs, builds, hosts, and maintains the software your business runs on. Some clients need one, many use both.',
  },
  {
    question: 'How much does custom software cost?',
    answer:
      'It depends on how much of the business the system has to run. Build My System publishes its pricing and its quote builder gives you an itemized number in a few minutes. Payment plans are available.',
  },
  {
    question: 'Should I fix my process before building software?',
    answer:
      'Usually, yes. Software built around a broken workflow makes the same mess faster. If you are not sure what the system should do yet, start with a Systems Audit call and we will work that out first.',
  },
];

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: SITE_URL },
    { name: 'Custom Software', url },
  ]),
  serviceSchema({
    name: 'Custom Software for Service Businesses',
    description:
      'Custom business systems for service businesses, designed and built by Build My System, with operations consulting from Build with Jeremy when the process needs fixing first.',
    url,
  }),
  faqSchema(faqs),
];
---

<Layout
  title="Custom Software for Service Businesses | Build with Jeremy"
  description="Need custom software, not consulting? Systems for service businesses are built under Build My System, my software company. Here is which one you need."
  jsonLd={jsonLd}
>
  <article class="py-16 lg:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <header>
        <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600 dark:text-indigo-400">Custom Software</p>
        <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white">
          Sometimes the answer is a system, not more advice.
        </h1>
        <p class="mt-6 text-xl leading-relaxed text-gray-700 dark:text-gray-300">
          Build with Jeremy is my consulting practice. When a business needs software built, that work happens at
          Build My System, my software company for service businesses. Same team, same standards, published pricing.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="https://buildmysystem.co/pricing" data-track="cta_click" class="inline-block rounded-lg bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700">
            Build your quote at Build My System
          </a>
          <a href="/contact/" data-track="cta_click" class="inline-block rounded-lg border border-gray-300 dark:border-gray-600 px-6 py-3 font-semibold text-gray-900 dark:text-white hover:border-indigo-600">
            Book a free Systems Audit call
          </a>
        </div>
      </header>

      <div class="mt-12 space-y-12">

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Consulting or software: which do you need?</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2">
            <div class="rounded-2xl border-2 border-indigo-600 dark:border-indigo-400 p-6">
              <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600 dark:text-indigo-400">Build My System</p>
              <h3 class="mt-2 text-xl font-bold text-gray-900 dark:text-white">Custom software</h3>
              <ul class="mt-4 space-y-2 text-gray-700 dark:text-gray-300">
                <li>You know what you need built</li>
                <li>The problem is the tools: too many apps, too much retyping</li>
                <li>You want one system that runs the work and the reporting</li>
                <li>You want it hosted, maintained, and improved over time</li>
              </ul>
              <a href="https://buildmysystem.co" class="mt-6 inline-block font-semibold text-indigo-600 dark:text-indigo-400">Go to Build My System &rarr;</a>
            </div>
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 p-6">
              <p class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Build with Jeremy</p>
              <h3 class="mt-2 text-xl font-bold text-gray-900 dark:text-white">Operations consulting</h3>
              <ul class="mt-4 space-y-2 text-gray-700 dark:text-gray-300">
                <li>You need help figuring out what to build</li>
                <li>The problem is process, ownership, or the team</li>
                <li>You want a fractional COO on retainer</li>
                <li>You want the system to stick after it ships</li>
              </ul>
              <a href="/services/" class="mt-6 inline-block font-semibold text-indigo-600 dark:text-indigo-400">See consulting services &rarr;</a>
            </div>
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Many clients use both</h2>
          <p class="mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
            The order depends on where the business is stuck.
          </p>
          <ul class="mt-6 space-y-4">
            {[
              ['Consulting first', 'Fix the process, then build the system around it. No point automating a workflow that is about to change.'],
              ['Software first', 'Get the system running, use it for a few months, then bring in consulting to tighten how the team works with it.'],
              ['Both together', 'An operations retainer alongside a system that is being built and improved in parallel.'],
            ].map(([t, d]) => (
              <li class="flex gap-4">
                <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-600 dark:bg-indigo-400"></span>
                <div>
                  <p class="font-semibold text-gray-900 dark:text-white">{t}</p>
                  <p class="mt-1 text-gray-700 dark:text-gray-300">{d}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Why the software lives at a separate company</h2>
          <p class="mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
            Consulting is a conversation about how your business runs. Software is a product with a build, a monthly
            bill, and a system that has to stay up. Keeping them apart means each one has clear pricing and a clear
            scope, and you can hire one without the other.
          </p>
          <p class="mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
            I spent 12 years at Google in operations, programs, and product launches. Both companies run on that: I
            design the system around how your team actually works, and it gets built to be relied on.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Common questions</h2>
          <div class="mt-6 space-y-4">
            {faqs.map((faq) => (
              <details data-track="faq_open" class="group rounded-lg border border-gray-200 dark:border-gray-700 p-5">
                <summary class="cursor-pointer font-semibold text-gray-900 dark:text-white list-none flex justify-between gap-4">
                  <span>{faq.question}</span>
                  <span class="text-gray-400 transition-transform group-open:rotate-180">&#9662;</span>
                </summary>
                <p class="mt-3 text-gray-700 dark:text-gray-300 leading-relaxed">{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Not sure which you need?</h2>
          <p class="mt-4 text-gray-700 dark:text-gray-300 leading-relaxed">
            Book a free Systems Audit call. Thirty minutes, and we will work out whether you need software,
            consulting, or both. If you already know what you want built, go straight to
            <a href="https://buildmysystem.co/pricing" class="text-indigo-600 dark:text-indigo-400 font-semibold">the Build My System quote builder</a>.
          </p>
          <a href="/contact/" data-track="cta_click" class="mt-6 inline-block rounded-lg bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700">
            Book a free Systems Audit call
          </a>
        </section>

      </div>
    </div>
  </article>
</Layout>
