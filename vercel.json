{
  "redirects": [
    {
      "source": "/jeremy",
      "destination": "https://buildwithjeremy.com/about/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.buildwithjeremy.com"
        }
      ],
      "destination": "https://buildwithjeremy.com/:path",
      "permanent": true
    }
  ]
}
